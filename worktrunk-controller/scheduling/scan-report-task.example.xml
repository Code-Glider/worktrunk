<?xml version="1.0" encoding="utf-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Worktrunk observation-only scan and trailing seven-day UTC report. Disabled example; replace all paths and the user SID before deployment qualification.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T03:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Owner">
      <UserId>REPLACE_WITH_WINDOWS_USER_SID</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>false</Enabled>
    <ExecutionTimeLimit>PT16M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Owner">
    <Exec>
      <Command>C:\Program Files\PowerShell\7\pwsh.exe</Command>
      <Arguments>-NoLogo -NoProfile -NonInteractive -File "C:\REPLACE\worktrunk\worktrunk-controller\scheduling\scan-report.ps1" -Node "C:\REPLACE\node.exe" -Config "C:\REPLACE\private\controller.json" -TimeoutSeconds 900</Arguments>
      <WorkingDirectory>C:\REPLACE\worktrunk</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
